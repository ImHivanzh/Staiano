  "narrative": {
    "northStar": "Registro operativo",
    "overview": "Registro operativo: una console scura e tecnica per leggere e confrontare licenze, software e postazioni. Il fondo navy e le superfici slate organizzano il lavoro; azzurro, verde e rosso comunicano azioni e stati.\n\nLa densità resta funzionale: un sans di sistema per i comandi, cifre tabulari per i confronti e monospace per identificativi e chiavi. Il sistema riguarda il pannello Licenses; il tema HVAC rimane indipendente.",
    "keyCharacteristics": [
      "Superfici navy e slate delimitate da bordi sottili.",
      "Comandi leggibili, cifre tabulari e identificativi monospace.",
      "Record allineati che si ricompongono su tablet e telefono."
    ],
    "rules": [
      {
        "name": "The Action and State Rule",
        "body": "Azzurro per azione primaria, selezione e focus; verde per stato attivo e rosso per revoca o errore. Accompagnare gli stati con testo.",
        "section": "colors"
      },
      {
        "name": "The Identifier Rule",
        "body": "Usare monospace per identificativi, versioni e chiavi; mantenere comandi, titoli e dati cliente nel sans operativo.",
        "section": "typography"
      },
      {
        "name": "The Bordered Surface Rule",
        "body": "Separare le superfici ordinarie con tono e bordo; riservare l'ombra al messaggio flottante.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do mantenere il tema scuro tecnico e la lingua italiana.",
      "Do conservare etichette di stato e focus visibile sui controlli.",
      "Do ricomporre i record mantenendo cliente, software, occupazione, stato e azioni riconoscibili."
    ],
    "donts": [
      "Don't usare il colore come unico segnale di stato.",
      "Don't estendere il monospace ai testi di interfaccia.",
      "Don't applicare il tema HVAC al pannello Licenses."
    ]
  }
}
